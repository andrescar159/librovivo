{% extends "base.html" %}

{% block title %}Mis Préstamos - LibroVivo{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="row align-items-center mb-4">
        <div class="col-md-8">
            <h2 class="text-warning">
                <i class="bi bi-journal-arrow-down"></i> Mis Préstamos
            </h2>
            <p class="text-muted mb-0">Historial de préstamos y devoluciones</p>
        </div>
        <div class="col-md-4 text-md-end">
            <a href="{{ url_for('dashboard.index') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver al Inicio
            </a>
        </div>
    </div>

    {% if prestamos %}
    <div class="row row-cols-1 row-cols-md-2 g-4">
        {% for p in prestamos %}
        <div class="col">
            <div class="card shadow-sm border-0 h-100 
                {% if p.estado == 'vencido' %}border-danger border-2{% endif %}">
                <div class="card-body bg-light">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title mb-0">{{ p.titulo_libro|default('Libro no disponible') }}</h5>
                        <span class="badge 
                            {% if p.estado == 'activo' %}bg-primary
                            {% elif p.estado == 'devuelto' %}bg-success
                            {% elif p.estado == 'vencido' %}bg-danger
                            {% else %}bg-secondary{% endif %}">
                            {{ p.estado|capitalize }}
                        </span>
                    </div>
                    <p class="text-muted small mb-2">{{ p.autor_libro|default('') }}</p>
                    
                    <div class="row small text-muted mb-2">
                        <div class="col-6">
                            <i class="bi bi-calendar"></i> Préstamo:<br>
                            <strong>{{ p.fecha_prestamo.strftime('%d/%m/%Y') if p.fecha_prestamo else '-' }}</strong>
                        </div>
                        <div class="col-6">
                            <i class="bi bi-calendar-check"></i> Devolución:<br>
                            <strong class="{% if p.estado == 'vencido' %}text-danger{% endif %}">
                                {{ p.fecha_devolucion_prevista.strftime('%d/%m/%Y') if p.fecha_devolucion_prevista else '-' }}
                            </strong>
                        </div>
                    </div>

                    {% if p.estado == 'activo' %}
                    <div class="mb-2">
                        {% if p.dias_restantes is defined %}
                            {% if p.dias_restantes > 0 %}
                                <span class="badge bg-success"><i class="bi bi-clock"></i> {{ p.dias_restantes }} días restantes</span>
                            {% elif p.dias_restantes == 0 %}
                                <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle"></i> Vence hoy</span>
                            {% else %}
                                <span class="badge bg-danger"><i class="bi bi-exclamation-circle"></i> Vencido {{ p.dias_restantes|abs }} días</span>
                            {% endif %}
                        {% endif %}
                    </div>
                    {% endif %}

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <small class="text-muted">Renovaciones: {{ p.renovaciones_usadas|default(0) }}/3</small>
                        <div>
                            <a href="{{ url_for('prestamos.ver', id=p.id) }}" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i> Ver
                            </a>
                            {% if p.estado == 'activo' %}
                            <form action="{{ url_for('prestamos.renovar', id=p.id) }}" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-warning text-dark">
                                    <i class="bi bi-arrow-repeat"></i> Renovar
                                </button>
                            </form>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="text-center py-5">
        <i class="bi bi-journal-x text-muted" style="font-size: 80px;"></i>
        <h4 class="text-muted mt-3">No tienes préstamos registrados</h4>
        <p class="text-muted">Explora el catálogo para reservar tu primer libro.</p>
        <a href="{{ url_for('libros.catalogo') }}" class="btn btn-warning text-dark fw-bold btn-lg">
            <i class="bi bi-collection"></i> Ver Catálogo
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}